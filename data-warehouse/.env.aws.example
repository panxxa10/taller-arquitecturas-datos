# Variables NO secretas (hosts, ARN de secretos, nombres). Las contraseñas viven en Secrets Manager.
# Se genera automáticamente con scripts/aws/sync_to_ec2.sh a partir de `terraform output`.
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
MYSQL_HOST=<rds_endpoint>
MYSQL_PORT=3306
MYSQL_DATABASE=dw_source
MYSQL_SECRET_ARN=<rds_secret_arn>
DOCDB_HOST=<docdb_endpoint>
DOCDB_SECRET_ARN=<docdb_secret_arn>
MONGO_DATABASE=ecommerce
DOCDB_CA_FILE=/opt/certs/global-bundle.pem
S3_BUCKET=<bucket>
REDSHIFT_HOST=<redshift_endpoint>
REDSHIFT_SECRET_ARN=<redshift_secret_arn>
REDSHIFT_ROLE_ARN=<redshift_role_arn>
REDSHIFT_WORKGROUP=taller-dw
REDSHIFT_DATABASE=dw
